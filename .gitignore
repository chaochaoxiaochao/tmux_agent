node_modules/
**/dist/
*.log
.DS_Store

# Design canvas exports — keep out of source tree
.design-canvas.state.json
*.zip
extracted/
*.png
*.mp4
# but track the README assets under docs/
!docs/*.png
!docs/*.mp4

# vue-tsc / tsc emit .js next to .ts and .vue.js next to .vue during type
# checks (incremental build artifacts). The runtime bundle comes from
# vite build under web/dist/, not these.
web/src/**/*.vue.js
web/src/**/*.js
web/tsconfig.tsbuildinfo

# Hook secrets — never commit
*.env
